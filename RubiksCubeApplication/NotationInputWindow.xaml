<Window x:Class="RubiksCubeApplication.NotationInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xtra="clr-namespace:RubiksCubeControl.Behaviors;assembly=RubiksCubeControl"
        xmlns:local="clr-namespace:RubiksCubeApplication"
        mc:Ignorable="d"
        Title="Enter Cube Notation" Height="450" Width="800"
        d:Height="420"         
        d:Width="871"        
        ResizeMode="CanResize"               
        >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="10">
            <Label Content="Enter Move Notation:" FontFamily="Cascadia Mono" FontSize="17" FontWeight="Normal" />
        </WrapPanel>

        <Grid Grid.Row="1" Margin="30,5,20,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="notationInput"       
                     xtra:TextBoxHelper.PlaceholderText="U R2 F B R B2 R U2 L B2 R U' D' R2 F R' L B2 U2 F2"                     
                     AcceptsReturn="True" VerticalScrollBarVisibility="Visible"
                     TextWrapping="Wrap"
                     TextBlock.LineHeight="2"                     
                     FontFamily="Cascadia Mono" FontSize="17" FontWeight="Normal" KeyDown="notationInput_KeyDown"                      
                     />
        </Grid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3,3,20,3" >

            <Button x:Name="buttonOK" Content="OK"        
                    Click="buttonOK_Click"
                    Margin="10" Padding="25,5" BorderThickness="1.75" 
                    FontFamily="Cascadia Mono" FontSize="20" FontWeight="Bold"></Button>

            <Button x:Name="buttonCancel" Content="Cancel"
                    Click="buttonCancel_Click"
                    Margin="10" Padding="25,5" BorderThickness="1.75" 
                    FontFamily="Cascadia Mono" FontSize="20" FontWeight="Bold"></Button>
        </WrapPanel>

    </Grid>
</Window>
